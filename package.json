{
	"name": "darksite",
	"version": "0.9.0",
	"description": "A dark-first, keyboard-driven design system for operator software, for Svelte 5.",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zebpalmer/darksite.git"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./base.css": "./dist/base.css",
		"./brands/*.css": "./dist/brands/*.css",
		"./brands/index.json": "./dist/brands/index.json",
		"./tokens.json": "./tokens.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"tokens.json",
		"CHANGELOG.md",
		"docs",
		"components/*/README.md",
		"bin",
		"brand",
		"NOTICE.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepare": "svelte-kit sync && svelte-package",
		"tokens": "node scripts/build-tokens.mjs && node scripts/build-brands.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "node scripts/build-tokens.mjs --check && node scripts/check-contrast.mjs && node scripts/build-brands.mjs --check && prettier --check . && npm run check && npm run package",
		"format": "prettier --write .",
		"test": "vitest run",
		"contrast": "node scripts/check-contrast.mjs -v",
		"brands": "node scripts/build-brands.mjs"
	},
	"peerDependencies": {
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@vitest/browser-playwright": "5.0.4",
		"jsdom": "^30.1.2",
		"playwright": "1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@lucide/svelte": "^1.57.0"
	},
	"bin": {
		"darksite-theme": "./bin/darksite-theme.mjs"
	}
}
